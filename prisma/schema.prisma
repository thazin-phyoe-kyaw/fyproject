datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  name              String
  createdAt         DateTime           @default(now())
  profile           Profile?
  resumes           Resume[]
  interviewSessions InterviewSession[]
  builtResume       BuiltResume?
  careerRoadmap     CareerRoadmap?
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetJobRole String
  experience    String
  skills        String   // Comma-separated candidate skills
  updatedAt     DateTime @updatedAt
}

model Resume {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl         String
  uploadedAt      DateTime         @default(now())
  analysisReports AnalysisReport[]
}

model AnalysisReport {
  id               String   @id @default(uuid())
  resumeId         String
  resume           Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  matchScore       Int
  missingKeywords  String   // Comma-separated missing keywords
  formattingIssues String   // Comma-separated formatting issues
  aiSuggestions    String
  createdAt        DateTime @default(now())
}

model InterviewSession {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String        // "ONGOING" or "COMPLETED"
  chatHistory ChatMessage[]
  feedback    Feedback?
  createdAt   DateTime      @default(now())
}

model ChatMessage {
  id        String           @id @default(uuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    String           // "USER" or "AI"
  message   String
  timestamp DateTime         @default(now())
}

model Feedback {
  id              String           @id @default(uuid())
  sessionId       String           @unique
  session         InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore    Int
  grammarScore    Int
  technicalScore  Int
  detailedAnalysis String
}

model BuiltResume {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String
  location     String
  website      String
  summary      String
  skills       String   // Comma-separated
  experience   Json     // array of experience objects
  education    Json     // array of education objects
  template     String   @default("classic") // classic, modern, tech
  themeColor   String   @default("slate")   // slate, indigo, emerald
  updatedAt    DateTime @updatedAt
}

model CareerRoadmap {
  id         String          @id @default(uuid())
  userId     String          @unique
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole String
  pace       String          @default("Standard") // Standard, Accelerated, Deep Dive
  focus      String          @default("Practical Projects") // Practical Projects, Conceptual Theory, Interview Prep
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  modules    RoadmapModule[]
}

model RoadmapModule {
  id        String        @id @default(uuid())
  roadmapId String
  roadmap   CareerRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  stepId    String        // "step_1", "step_2", etc.
  title     String
  status    String        // "COMPLETED" | "IN_PROGRESS" | "LOCKED"
  time      String
  concepts  String        // Comma-separated
  resources String        // Comma-separated
  order     Int
}
